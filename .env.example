# Copy this file to ".env" and paste your own keys after the "=" signs.
# Never commit the real .env file - it is listed in .gitignore.

# Groq API Key (free from https://console.groq.com/keys)
GROQ_API_KEY=

# Global Fishing Watch API Token (free from https://globalfishingwatch.org/our-apis/)
GFW_API_TOKEN=
